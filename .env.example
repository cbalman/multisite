# Multisite — local development
# Copy to .env and adjust if needed

APP_NAME=Multisite
APP_ENV=development
APP_DOMAIN=localhost
APP_URL=http://localhost

# Postgres
POSTGRES_USER=multisite
POSTGRES_PASSWORD=multisite
POSTGRES_DB=multisite
DATABASE_URL=postgresql+psycopg://multisite:multisite@db:5432/multisite

# Auth
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Media
MEDIA_ROOT=/app/uploads
MAX_IMAGE_MB=5
MAX_VIDEO_MB=80
MAX_VIDEOS_PER_PUBLICATION=1

# CORS (comma-separated origins for local Vite if not behind nginx)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
